# Copy to .env.local and fill in. .env.* is gitignored — never commit the real key.
#
# The agent talks to Gemini straight from the browser, so this key ships inside
# the bundle and anyone can read it out of the deployed site. Use a throwaway
# key with a low daily quota for demos, and rotate it afterwards. If the site
# ever goes properly public, put a serverless proxy in front of it and point
# VITE_GEMINI_PROXY_URL at that instead — the key then stays server-side.
VITE_GEMINI_API_KEY=

# Optional. When set, the agent POSTs to this URL instead of calling Google
# directly, and VITE_GEMINI_API_KEY is ignored.
VITE_GEMINI_PROXY_URL=
